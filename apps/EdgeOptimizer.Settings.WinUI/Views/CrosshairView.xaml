<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.CrosshairView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock Text="Image preview" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Position is relative to the center of the screen" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel><ToggleSwitch HorizontalAlignment="Right" Header="Overlay" IsOn="{Binding OverlayEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="Crosshair.Enabled"/></Grid>
          <Border Grid.Row="1" Margin="0,18,0,14" MinHeight="390" Background="#080D12" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" CornerRadius="7">
            <Grid>
              <Line X1="0" Y1="0" X2="0" Y2="1000" Stroke="#243746" StrokeThickness="1" HorizontalAlignment="Center"/>
              <Line X1="0" Y1="0" X2="1600" Y2="0" Stroke="#243746" StrokeThickness="1" VerticalAlignment="Center"/>
              <Grid Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RenderTransform><TranslateTransform X="{Binding XOffset}" Y="{Binding YOffset}"/></Grid.RenderTransform>
                <Image x:Name="PreviewImage" Width="100" Height="100" Stretch="Uniform" AutomationProperties.Name="Crosshair preview"/>
                <Grid x:Name="FallbackCrosshair" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45">
                  <Rectangle Width="3" Height="14" Fill="{ThemeResource AppAccentBrush}" VerticalAlignment="Top"/><Rectangle Width="3" Height="14" Fill="{ThemeResource AppAccentBrush}" VerticalAlignment="Bottom"/><Rectangle Width="14" Height="3" Fill="{ThemeResource AppAccentBrush}" HorizontalAlignment="Left"/><Rectangle Width="14" Height="3" Fill="{ThemeResource AppAccentBrush}" HorizontalAlignment="Right"/><Ellipse Width="4" Height="4" Fill="{ThemeResource AppAccentBrush}"/>
                </Grid>
              </Grid>
              <Border x:Name="PreviewNotice" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Padding="12,6" CornerRadius="6" Background="#CC101A25">
                <TextBlock x:Name="PreviewNoticeText" Foreground="#D6E2EE" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
              </Border>
            </Grid>
          </Border>
          <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ImageName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ImagePath}"/><TextBlock Grid.Column="1" Text="{Binding OffsetSummary}" Style="{StaticResource MutedTextStyle}"/></Grid>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Crosshair image" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="PNG with transparency · 100 × 100 recommended" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
            <Button Command="{Binding ReplaceImageCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Crosshair.ChooseImage"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEB9F;" FontSize="14"/><TextBlock Text="Choose PNG…"/></StackPanel></Button>
            <Button Content="Remove image" Command="{Binding RemoveImageCommand}" HorizontalAlignment="Stretch"/>
          </StackPanel></Border>
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Position" Style="{StaticResource SectionTitleStyle}"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><NumberBox Header="X offset (px)" Minimum="-500" Maximum="500" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" Value="{Binding XOffset, Mode=TwoWay}"/><NumberBox Grid.Column="1" Header="Y offset (px)" Minimum="-500" Maximum="500" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" Value="{Binding YOffset, Mode=TwoWay}"/></Grid>
            <Grid HorizontalAlignment="Center" Margin="0,8,0,0" RowSpacing="4" ColumnSpacing="4"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Grid.Column="1" Command="{Binding MoveCommand}" CommandParameter="Up" Width="48" Height="40" AutomationProperties.Name="Nudge up" ToolTipService.ToolTip="Nudge up 1 px"><FontIcon Glyph="&#xE70E;" FontSize="14"/></Button>
              <Button Grid.Row="1" Command="{Binding MoveCommand}" CommandParameter="Left" Width="48" Height="40" AutomationProperties.Name="Nudge left" ToolTipService.ToolTip="Nudge left 1 px"><FontIcon Glyph="&#xE76B;" FontSize="14"/></Button>
              <Button Grid.Row="1" Grid.Column="1" Command="{Binding CenterCommand}" Width="48" Height="40" AutomationProperties.Name="Center" ToolTipService.ToolTip="Center on screen"><FontIcon Glyph="&#xF272;" FontSize="14"/></Button>
              <Button Grid.Row="1" Grid.Column="2" Command="{Binding MoveCommand}" CommandParameter="Right" Width="48" Height="40" AutomationProperties.Name="Nudge right" ToolTipService.ToolTip="Nudge right 1 px"><FontIcon Glyph="&#xE76C;" FontSize="14"/></Button>
              <Button Grid.Row="2" Grid.Column="1" Command="{Binding MoveCommand}" CommandParameter="Down" Width="48" Height="40" AutomationProperties.Name="Nudge down" ToolTipService.ToolTip="Nudge down 1 px"><FontIcon Glyph="&#xE70D;" FontSize="14"/></Button>
            </Grid>
            <Button Content="Reset crosshair" Command="{Binding ResetCommand}" HorizontalAlignment="Stretch"/>
          </StackPanel></Border>
          <TextBlock Text="{Binding FeedbackText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,12"><Grid><Button Content="Turn overlay off" Command="{Binding HidePreviewCommand}" HorizontalAlignment="Left"/><Button Content="Save changes" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="Crosshair.Save"/></Grid></Border>
  </Grid>
</UserControl>
