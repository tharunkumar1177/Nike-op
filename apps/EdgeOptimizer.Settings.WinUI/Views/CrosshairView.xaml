<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.CrosshairView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock Text="Image preview" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="16:9 preview · position is relative to screen center" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel><ToggleSwitch HorizontalAlignment="Right" Header="Overlay" IsOn="{Binding OverlayEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="Crosshair.Enabled"/></Grid>
          <Border Grid.Row="1" Margin="0,18,0,14" MinHeight="390" Background="#080D12" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" CornerRadius="7">
            <Grid>
              <Grid.Background><SolidColorBrush Color="#080D12"/></Grid.Background>
              <Line X1="0" Y1="0" X2="0" Y2="1000" Stroke="#243746" StrokeThickness="1" HorizontalAlignment="Center"/>
              <Line X1="0" Y1="0" X2="1600" Y2="0" Stroke="#243746" StrokeThickness="1" VerticalAlignment="Center"/>
              <Grid Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RenderTransform><TranslateTransform X="{Binding XOffset}" Y="{Binding YOffset}"/></Grid.RenderTransform>
                <Image x:Name="PreviewImage" Width="100" Height="100" Stretch="Uniform"/>
                <Grid x:Name="FallbackCrosshair" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Rectangle Width="3" Height="14" Fill="{ThemeResource AppAccentBrush}" VerticalAlignment="Top"/><Rectangle Width="3" Height="14" Fill="{ThemeResource AppAccentBrush}" VerticalAlignment="Bottom"/><Rectangle Width="14" Height="3" Fill="{ThemeResource AppAccentBrush}" HorizontalAlignment="Left"/><Rectangle Width="14" Height="3" Fill="{ThemeResource AppAccentBrush}" HorizontalAlignment="Right"/><Ellipse Width="4" Height="4" Fill="{ThemeResource AppAccentBrush}"/>
                </Grid>
              </Grid>
            </Grid>
          </Border>
          <Grid Grid.Row="2"><TextBlock Text="{Binding ImageName}"/><TextBlock Text="{Binding OffsetSummary}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}"/></Grid>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Crosshair image" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="PNG · recommended 100 × 100" Style="{StaticResource MutedTextStyle}"/><Button Content="Replace PNG" Command="{Binding ReplaceImageCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch"/><Button Content="Remove image" Command="{Binding RemoveImageCommand}" HorizontalAlignment="Stretch"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Position" Style="{StaticResource SectionTitleStyle}"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><NumberBox Header="X offset" Minimum="-500" Maximum="500" SmallChange="1" Value="{Binding XOffset, Mode=TwoWay}"/><NumberBox Grid.Column="1" Header="Y offset" Minimum="-500" Maximum="500" SmallChange="1" Value="{Binding YOffset, Mode=TwoWay}"/></Grid>
            <Grid HorizontalAlignment="Center" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Grid.Column="1" Content="↑" Command="{Binding MoveCommand}" CommandParameter="Up" Width="48"/><Button Grid.Row="1" Content="←" Command="{Binding MoveCommand}" CommandParameter="Left" Width="48"/><Button Grid.Row="1" Grid.Column="1" Content="◎" Command="{Binding CenterCommand}" Width="48"/><Button Grid.Row="1" Grid.Column="2" Content="→" Command="{Binding MoveCommand}" CommandParameter="Right" Width="48"/><Button Grid.Row="2" Grid.Column="1" Content="↓" Command="{Binding MoveCommand}" CommandParameter="Down" Width="48"/>
            </Grid>
            <Button Content="Reset crosshair" Command="{Binding ResetCommand}" HorizontalAlignment="Stretch"/>
          </StackPanel></Border>
          <TextBlock Text="{Binding FeedbackText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,12"><Grid><Button Content="Hide overlay" Command="{Binding HidePreviewCommand}" HorizontalAlignment="Left"/><Button Content="Save changes" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"/></Grid></Border>
  </Grid>
</UserControl>
