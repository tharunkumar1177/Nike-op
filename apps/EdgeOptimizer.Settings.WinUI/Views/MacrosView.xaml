<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.MacrosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:EdgeOptimizer.Settings.Core.Models">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Macros" Style="{StaticResource SectionTitleStyle}"/>
          <AutoSuggestBox Grid.Row="1" PlaceholderText="Search macros" QueryIcon="Find" Text="{Binding MacroSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,12" AutomationProperties.Name="Search macros"/>
          <ListView Grid.Row="2" ItemsSource="{Binding FilteredMacros}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="Macros.List" AutomationProperties.Name="Macros">
            <ListView.ItemTemplate><DataTemplate x:DataType="models:MacroDefinition"><Grid MinHeight="48" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" VerticalAlignment="Center" Background="{ThemeResource AppAccentSubtleBrush}" BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="7,3"><TextBlock Text="{x:Bind Shortcut, Mode=OneWay}" Foreground="{ThemeResource AppAccentBrush}" FontSize="11"/></Border></Grid></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <TextBlock Grid.Row="2" Text="No macros in this profile yet." Style="{StaticResource EmptyStateTextStyle}" VerticalAlignment="Center" Visibility="{Binding HasMacros, Converter={StaticResource InverseBoolToVisibility}}"/>
          <Button Grid.Row="3" Command="{Binding NewMacroCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" AutomationProperties.AutomationId="Macros.New"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="New macro"/></StackPanel></Button>
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Action sequence" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Actions run from top to bottom. Drag the handle to reorder." Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel>
          <ListView Grid.Row="1" ItemsSource="{Binding SelectedMacro.Steps}" SelectionMode="None" CanDragItems="True" CanReorderItems="True" AllowDrop="True" Background="Transparent" BorderThickness="0" Margin="0,16,0,12" AutomationProperties.AutomationId="Macros.Steps" AutomationProperties.Name="Macro actions" Visibility="{Binding HasSelectedMacro, Converter={StaticResource BoolToVisibility}}">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate x:DataType="models:MacroStep"><Border Style="{StaticResource InsetStyle}" Padding="8" Margin="0,0,0,8"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE76F;" FontSize="14" Foreground="{ThemeResource AppMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8" ToolTipService.ToolTip="Drag to reorder"/>
              <ComboBox Grid.Column="1" Header="Action" SelectedIndex="{x:Bind ActionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Choose…" AutomationProperties.Name="Action type">
                <ComboBoxItem Content="Key press"/><ComboBoxItem Content="Key down"/><ComboBoxItem Content="Key up"/><ComboBoxItem Content="Wait"/><ComboBoxItem Content="Mouse down"/><ComboBoxItem Content="Mouse up"/><ComboBoxItem Content="Mouse move"/>
              </ComboBox>
              <TextBox Grid.Column="2" Header="Value" Text="{x:Bind Value, Mode=TwoWay}" PlaceholderText="W · 120 · Left · 640, 360"/>
              <Button Grid.Column="3" Tag="{Binding}" Click="OnDeleteStepClick" Width="34" Height="32" VerticalAlignment="Bottom" AutomationProperties.Name="Delete action" ToolTipService.ToolTip="Delete action"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
            </Grid></Border></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6" Visibility="{Binding HasSelectedMacro, Converter={StaticResource InverseBoolToVisibility}}">
            <FontIcon Glyph="&#xE765;" FontSize="32" Foreground="{ThemeResource AppMutedBrush}"/>
            <TextBlock Text="Select or create a macro to edit its actions." Style="{StaticResource EmptyStateTextStyle}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="8">
            <Button Command="{Binding AddActionCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Macros.AddAction"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="Add action"/></StackPanel></Button>
            <TextBlock Text="Values: a key name for key actions, milliseconds for Wait, Left/Right/Middle for mouse buttons, and x, y for Mouse move. Recording and test playback are not available yet." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource CardStyle}">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelectedMacro, Converter={StaticResource BoolToVisibility}}"><StackPanel Spacing="18"><TextBlock Text="Trigger &amp; playback" Style="{StaticResource SectionTitleStyle}"/>
            <InfoBar IsOpen="{Binding HasValidationMessage}" IsClosable="False" Severity="Warning" Title="Needs attention" Message="{Binding ValidationMessage}"/>
            <ToggleSwitch Header="Enabled" IsOn="{Binding SelectedMacro.IsEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="Macros.Enabled"/>
            <TextBox Header="Macro name" Text="{Binding SelectedMacro.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" AutomationProperties.AutomationId="Macros.Name"/>
            <StackPanel Spacing="4"><TextBox Header="Shortcut" Text="{Binding SelectedMacro.Shortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ctrl + F8" AutomationProperties.AutomationId="Macros.Shortcut"/><TextBlock Text="A modifier (Ctrl, Alt, Shift, Win) plus a letter, digit, or F1–F12. Use Unassigned for none." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Spacing="8"><TextBlock Text="Playback mode" Style="{StaticResource MutedTextStyle}"/><ComboBox SelectedIndex="{Binding SelectedMacro.RepeatModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Playback mode"><ComboBoxItem Content="Run once"/><ComboBoxItem Content="Repeat a fixed count"/><ComboBoxItem Content="Repeat until stop key"/></ComboBox>
              <NumberBox Header="Repeat count" Value="{Binding SelectedMacro.RepeatCountValue, Mode=TwoWay}" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" Visibility="{Binding SelectedMacro.UsesRepeatCount, Converter={StaticResource BoolToVisibility}}"/>
              <TextBox Header="Stop key" Text="{Binding SelectedMacro.StopKey, Mode=TwoWay}" PlaceholderText="Escape" Visibility="{Binding SelectedMacro.UsesStopKey, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="Saved macros are delivered to the unprivileged worker when this profile is activated."/>
          </StackPanel></ScrollViewer>
          <TextBlock Text="No macro selected." Style="{StaticResource EmptyStateTextStyle}" VerticalAlignment="Center" Visibility="{Binding HasSelectedMacro, Converter={StaticResource InverseBoolToVisibility}}"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,12"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Command="{Binding DeleteMacroCommand}" Style="{StaticResource DangerButtonStyle}" AutomationProperties.AutomationId="Macros.Delete"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14"/><TextBlock Text="Delete macro"/></StackPanel></Button><TextBlock Grid.Column="1" Text="{Binding FeedbackText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FeedbackText}"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"><Button Content="Duplicate" Command="{Binding DuplicateMacroCommand}"/><Button Content="Save macros" Command="{Binding SaveMacroCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="Macros.Save"/></StackPanel></Grid></Border>
  </Grid>
</UserControl>
