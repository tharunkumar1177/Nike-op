<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.SystemTweaksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:EdgeOptimizer.Settings.Core.Models">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Performance policy" Style="{StaticResource SectionTitleStyle}"/><Border Style="{StaticResource InsetStyle}"><Grid><StackPanel><TextBlock Text="Fan speed boost" FontWeight="SemiBold"/><TextBlock Text="Maximum fan speed while this profile is active" Style="{StaticResource MutedTextStyle}" Margin="0,4,90,0"/></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding FanBoostEnabled, Mode=TwoWay}" IsEnabled="False" AutomationProperties.Name="Fan speed boost"/></Grid></Border><InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="Fan policy is unavailable until supported hardware and rollback behavior are defined."/></StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Apps to close" Style="{StaticResource SectionTitleStyle}"/><TextBlock Grid.Row="1" Text="Runner closes the selected apps when this profile is activated. Selected apps that are not running stay on the list." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <Grid Grid.Row="2" ColumnSpacing="10" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <AutoSuggestBox PlaceholderText="Search apps" QueryIcon="Find" Text="{Binding ProcessFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search apps"/>
              <Button Grid.Column="1" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh running apps" ToolTipService.ToolTip="Refresh running apps" AutomationProperties.AutomationId="SystemTweaks.Refresh"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
              <Button Grid.Column="2" Content="Clear" Command="{Binding ClearSelectionCommand}" ToolTipService.ToolTip="Deselect all apps"/>
              <Border Grid.Column="3" Style="{StaticResource InsetStyle}" Padding="12,6"><TextBlock Text="{Binding SelectionSummary}" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center"/></Border>
            </Grid>
            <Border Grid.Row="3" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" CornerRadius="7">
              <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource AppInsetBrush}" CornerRadius="7,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="APP" Style="{StaticResource MutedTextStyle}" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource MutedTextStyle}" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource MutedTextStyle}" FontSize="12" VerticalAlignment="Center"/></Grid>
                <ListView Grid.Row="1" ItemsSource="{Binding FilteredProcesses}" SelectionMode="None" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="SystemTweaks.Processes" AutomationProperties.Name="Apps to close"><ListView.ItemTemplate><DataTemplate x:DataType="models:ProcessItem"><Grid MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" AutomationProperties.Name="{x:Bind Name}"/><TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{x:Bind Cpu}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{x:Bind Memory}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10" Margin="16" Visibility="{Binding IsProcessListEmpty, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{Binding ProcessListEmptyText}" Style="{StaticResource EmptyStateTextStyle}"/>
                  <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14">
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Cleanup" Style="{StaticResource SectionTitleStyle}"/>
          <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="Cleanup is moving to its own page, which shows how much will be deleted before anything is removed."/>
          <Border Style="{StaticResource InsetStyle}" Opacity="0.6"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource AppMutedBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="Recycle Bin" FontWeight="SemiBold"/><TextBlock Text="Permanently empty the Recycle Bin" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="Run now" IsEnabled="False" AutomationProperties.HelpText="Unavailable until the Cleanup page adds a size preview."/></Grid></Border>
          <Border Style="{StaticResource InsetStyle}" Opacity="0.6"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE774;" Foreground="{ThemeResource AppMutedBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="Browser cache" FontWeight="SemiBold"/><TextBlock Text="Clear cached files for Chrome and Edge" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="Run now" IsEnabled="False" AutomationProperties.HelpText="Unavailable until the Cleanup page adds a size preview."/></Grid></Border>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="Safety" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Protected, critical, and ambiguous Windows processes are always excluded when Runner closes apps, even if they are selected here." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="What activation does" Style="{StaticResource SectionTitleStyle}"/>
          <TextBlock Text="1.  Saves this profile through Runner" TextWrapping="Wrap"/>
          <TextBlock Text="2.  Closes the selected apps, skipping protected processes" TextWrapping="Wrap"/>
          <TextBlock Text="3.  Starts the crosshair overlay if an image is set" TextWrapping="Wrap"/>
          <TextBlock Text="4.  Starts the macro worker with this profile's macros" TextWrapping="Wrap"/>
          <TextBlock Text="Machine-level policies such as fan control are not applied yet." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <TextBlock Text="{Binding FeedbackText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,12"><Grid><Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" HorizontalAlignment="Left"/><Button Content="Save changes" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SystemTweaks.Save"/></Grid></Border>
  </Grid>
</UserControl>
