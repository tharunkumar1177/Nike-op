<UserControl x:Class="EdgeOptimizer.Settings.WinUI.Views.SystemTweaksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:EdgeOptimizer.Settings.Core.Models">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Performance policy" Style="{StaticResource SectionTitleStyle}"/><Border Style="{StaticResource InsetStyle}"><Grid><StackPanel><TextBlock Text="Fan speed boost" FontWeight="SemiBold"/><TextBlock Text="Maximum fan speed while this profile is active" Style="{StaticResource MutedTextStyle}" Margin="0,4,90,0"/></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding FanBoostEnabled, Mode=TwoWay}"/></Grid></Border><InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="Fan policy remains unavailable until supported hardware and rollback behavior are defined."/></StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Apps to close" Style="{StaticResource SectionTitleStyle}"/><TextBlock Grid.Row="1" Text="Close non-essential apps when optimization starts" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,14"/>
            <Grid Grid.Row="2" ColumnSpacing="10" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox PlaceholderText="Search running apps" Text="{Binding ProcessFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="↻" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh process list"/><Border Grid.Column="2" Style="{StaticResource InsetStyle}" Padding="12,8"><TextBlock Text="{Binding SelectionSummary}" Foreground="{ThemeResource AppAccentBrush}"/></Border></Grid>
            <Border Grid.Row="3" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" CornerRadius="7">
              <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource AppInsetBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="PROCESS" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/></Grid>
                <ListView Grid.Row="1" ItemsSource="{Binding FilteredProcesses}" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate x:DataType="models:ProcessItem"><Grid MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/><TextBlock Grid.Column="1" Text="{x:Bind Name}"/><TextBlock Grid.Column="2" Text="{x:Bind Cpu}" Style="{StaticResource MutedTextStyle}"/><TextBlock Grid.Column="3" Text="{x:Bind Memory}" Style="{StaticResource MutedTextStyle}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14">
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Cleanup actions" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Unavailable until cleanup runs in the verified interactive-user context" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
          <Border Style="{StaticResource InsetStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding RecycleBinEnabled, Mode=TwoWay}" IsEnabled="False" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBlock Text="Recycle Bin" FontWeight="SemiBold"/><TextBlock Text="Remove deleted files" Style="{StaticResource MutedTextStyle}" FontSize="12"/></StackPanel><Button Grid.Column="2" Content="Run now" IsEnabled="False" ToolTipService.ToolTip="Blocked until Runner owns user-context cleanup."/></Grid></Border>
          <Border Style="{StaticResource InsetStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding BrowserCacheEnabled, Mode=TwoWay}" IsEnabled="False" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBlock Text="Browser cache" FontWeight="SemiBold"/><TextBlock Text="Clear temporary browser data" Style="{StaticResource MutedTextStyle}" FontSize="12"/></StackPanel><Button Grid.Column="2" Content="Run now" IsEnabled="False" ToolTipService.ToolTip="Blocked until Runner owns user-context cleanup."/></Grid></Border>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="Safety" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Protected, critical, and ambiguous Windows processes are always excluded at execution time." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/><Button Content="View protected list" Command="{Binding ProtectedListCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="Activation plan" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="✓  Save profile through Runner"/><TextBlock Text="✓  Close selected apps safely"/><TextBlock Text="✓  Start configured crosshair worker"/><TextBlock Text="✓  Start configured macro worker"/><TextBlock Text="○  Apply supported machine policy" Style="{StaticResource MutedTextStyle}"/></StackPanel></Border>
        <TextBlock Text="{Binding FeedbackText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,12"><Grid><Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" HorizontalAlignment="Left"/><Button Content="Save changes" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"/></Grid></Border>
  </Grid>
</UserControl>
