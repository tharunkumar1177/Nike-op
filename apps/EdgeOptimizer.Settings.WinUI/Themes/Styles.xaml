<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="AppCanvasBrush" Color="#0A1119"/>
      <SolidColorBrush x:Key="AppSidebarBrush" Color="#0C151E"/>
      <SolidColorBrush x:Key="AppCardBrush" Color="#101A25"/>
      <SolidColorBrush x:Key="AppInsetBrush" Color="#0B131C"/>
      <SolidColorBrush x:Key="AppStrokeBrush" Color="#293848"/>
      <SolidColorBrush x:Key="AppMutedBrush" Color="#9FB0C1"/>
      <SolidColorBrush x:Key="AppAccentBrush" Color="#16A8F5"/>
      <SolidColorBrush x:Key="AppSuccessBrush" Color="#39D879"/>
      <SolidColorBrush x:Key="AppDangerBrush" Color="#FF6572"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppCanvasBrush" Color="#F3F7FB"/>
      <SolidColorBrush x:Key="AppSidebarBrush" Color="#EAF1F7"/>
      <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="AppInsetBrush" Color="#F4F7FA"/>
      <SolidColorBrush x:Key="AppStrokeBrush" Color="#D4DEE8"/>
      <SolidColorBrush x:Key="AppMutedBrush" Color="#526579"/>
      <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4"/>
      <SolidColorBrush x:Key="AppSuccessBrush" Color="#118A43"/>
      <SolidColorBrush x:Key="AppDangerBrush" Color="#C42B1C"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AppCardBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="20"/>
  </Style>
  <Style x:Key="InsetStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AppInsetBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="MutedTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource AppMutedBrush}"/>
  </Style>
  <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="46"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="7"/>
  </Style>
  <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Foreground" Value="{ThemeResource AppDangerBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="MetricValueStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
  </Style>
</ResourceDictionary>
